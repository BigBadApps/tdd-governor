{
  "name": "tdd-governor",
  "version": "0.1.0",
  "description": "Git-hook gate that blocks commits lacking real TDD evidence: red before green, no skipped tests, optional mutation coverage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BigBadApps/tdd-governor.git"
  },
  "bugs": {
    "url": "https://github.com/BigBadApps/tdd-governor/issues"
  },
  "homepage": "https://github.com/BigBadApps/tdd-governor#readme",
  "keywords": [
    "tdd",
    "test-driven-development",
    "git-hooks",
    "vitest",
    "mutation-testing",
    "ai-coding-agents",
    "claude-code"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "governor": "./dist/cli.js"
  },
  "exports": {
    "./vitest-reporter": "./dist/adapters/vitest/reporter.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
